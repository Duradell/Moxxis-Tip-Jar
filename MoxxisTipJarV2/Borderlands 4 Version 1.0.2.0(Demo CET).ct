if syntaxcheck then return end
[ENABLE]
local ok, address = pcall(getAddress, "[[[[[[[[ReyLambChops]+1358]+38]+0]+30]+3D0]+5FF0]+20]+74")
if not ok or address == 0 then
   error("⚠️ Instance Not Found (check ReyLambChops symbol or pointer chain)")
end

someBackup = readFloat(address) or 1.0
writeFloat(address, 99.0)
healthFreeze = createTimer(nil, false)
healthFreeze.Interval = 100
healthFreeze.OnTimer = function()
  if address ~= 0 then
    writeFloat(address, 99.0)
  end
end
healthFreeze.Enabled = true

[DISABLE]
if healthFreeze then
  healthFreeze.Enabled = false
  healthFreeze.Destroy()
  healthFreeze = nil
end

local ok, address = pcall(getAddress, "[[[[[[[[ReyLambChops]+1358]+38]+0]+30]+3D0]+5FF0]+20]+74")
if ok and address ~= 0 and someBackup ~= nil then
  writeFloat(address, someBackup)
end

