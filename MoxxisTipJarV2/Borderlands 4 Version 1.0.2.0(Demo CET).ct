if syntaxcheck then return end

[ENABLE]
local address = getAddress("[[[[[[ReyLambChops]+1358]+38]+0]+30]+3D0]+4084")
if address ~= 0 then
   someBackup = readDouble(address) or 0
   writeDouble(address, 0.0)

   healthFreeze = createTimer(nil, false)
   healthFreeze.Interval = 100
   healthFreeze.OnTimer = function()
     if address ~= 0 then
       writeDouble(address, 99999.0)
     end
   end
   healthFreeze.Enabled = true
else
   error("Instance Not Found")
end

[DISABLE]
if healthFreeze then
   healthFreeze.Enabled = false
   healthFreeze.Destroy()
   healthFreeze = nil
end

local address = getAddress("[[[[[[ReyLambChops]+1358]+38]+0]+30]+3D0]+4084")
